:root {
  color-scheme: light;
  --bg: #f7f6f3;
  --bg-soft: #fefcf9;
  --text: #1c1a18;
  --muted: #6d6760;
  --muted-strong: #3a3632;
  --line: rgba(28, 26, 24, 0.12);
  --accent: #8b8276;
  --accent-soft: rgba(139, 130, 118, 0.18);
  --glass: rgba(255, 255, 255, 0.72);
  --glass-strong: rgba(255, 255, 255, 0.86);
  --glass-border: rgba(28, 26, 24, 0.12);
  --glass-highlight: rgba(255, 255, 255, 0.9);
  --shadow-lg: 0 28px 60px rgba(28, 26, 24, 0.08);
  --shadow-md: 0 18px 40px rgba(28, 26, 24, 0.06);
  --shadow-sm: 0 10px 24px rgba(28, 26, 24, 0.05);
  --radius-lg: 28px;
  --radius-md: 20px;
  --radius-sm: 14px;
}

* {
  box-sizing: border-box;
  scroll-behavior: smooth;
  user-select: none;
  -webkit-user-select: none;
  -webkit-user-drag: none;
}

input, textarea {
  user-select: auto;
  -webkit-user-select: auto;
}

html {
  scroll-behavior: smooth;
  overflow-y: overlay; /* Allows the scrollbar to float OVER the content on some browsers */
  overscroll-behavior: none; /* Disables swipe-to-go-back and bounce effects */
}

/* Custom Webkit Scrollbar */
::-webkit-scrollbar {
  width: 8px;
  background: transparent; /* Forces the gutter to be transparent */
}

::-webkit-scrollbar-track {
  background: transparent;
  background-color: transparent;
}

::-webkit-scrollbar-thumb {
  background: rgba(0, 0, 0, 0.4); 
  border-radius: 999px;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(0, 0, 0, 0.6);
}

body {
  margin: 0;
  font-family: var(--font-sans), system-ui, -apple-system, "Segoe UI", sans-serif;
  background: linear-gradient(180deg, #e8eef7 0%, #f7f6f3 42%, #fefcf9 100%);
  color: var(--text);
  line-height: 1.6;
  touch-action: pan-y; /* Disables pinch-to-zoom but allows vertical scrolling */
}

section {
  scroll-margin-top: 120px;
}

a {
  color: inherit;
  text-decoration: none;
}

img {
  max-width: 100%;
  display: block;
}

main {
  overflow: hidden;
}

.section {
  padding: 96px 0;
}

.section-inner {
  width: min(1160px, calc(100% - 48px));
  margin: 0 auto;
}

.eyebrow {
  font-size: 12px;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--muted);
  margin: 0 0 14px;
}

.display {
  font-family: var(--font-display), "Times New Roman", serif;
  font-style: italic;
  font-weight: 400;
  letter-spacing: -0.02em;
  color: var(--text);
}

.accent {
  font-family: var(--font-accent), "Times New Roman", serif;
  font-style: italic;
  color: var(--accent);
}

.glass {
  background: var(--glass);
  border: 1px solid var(--glass-border);
  box-shadow: var(--shadow-md), inset 0 1px 0 var(--glass-highlight);
  backdrop-filter: blur(18px);
}

.glass-strong {
  background: var(--glass-strong);
  border: 1px solid var(--glass-border);
  box-shadow: var(--shadow-lg), inset 0 1px 0 var(--glass-highlight);
  backdrop-filter: blur(22px);
}

.glass-line {
  height: 1px;
  background: linear-gradient(90deg, transparent 0%, var(--line) 25%, var(--line) 75%, transparent 100%);
}

.nav-wrap {
  pointer-events: none;
}

.nav-wrap > div {
  pointer-events: auto;
}

.nav-link-hover:hover {
  opacity: 0.7;
}

.menu-toggle {
  display: none;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 12px 22px;
  border-radius: 999px;
  border: 1px solid var(--glass-border);
  font-size: 14px;
  font-weight: 500;
  transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  backdrop-filter: blur(14px);
}

.btn-primary {
  background: rgba(28, 26, 24, 0.86);
  color: #fefcf9;
  box-shadow: var(--shadow-sm);
}

.btn-primary:hover {
  transform: translateY(-1px);
  box-shadow: var(--shadow-md);
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.4);
  color: var(--muted-strong);
}

.btn-ghost:hover {
  transform: translateY(-1px);
}

.pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  border-radius: 999px;
  font-size: 12px;
  color: var(--muted);
}

.reveal {
  opacity: 0;
  transform: translateY(18px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}

.reveal-visible {
  opacity: 1;
  transform: translateY(0);
}

.hero {
  padding-top: 180px;
  padding-bottom: 120px;
  min-height: 100vh;
  width: 100%;
  display: flex;
  align-items: center;
  position: relative;
  background: url('/brand/background.png') center/cover no-repeat;
  border-bottom: 1px solid var(--glass-border);
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 60px;
  align-items: center;
  position: relative;
  z-index: 1;
}

.hero-title {
  font-family: var(--font-sans), system-ui, sans-serif;
  font-size: clamp(44px, 6vw, 64px);
  margin: 0 0 24px;
  font-weight: 500;
  letter-spacing: -0.03em;
  font-style: normal;
  line-height: 1.1;
}

.hero-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 16px;
  border-radius: 18px;
  border: 1px solid var(--glass-border);
  background: rgba(255, 255, 255, 0.8);
  box-shadow: var(--shadow-sm);
  backdrop-filter: blur(16px);
  width: min(420px, 100%);
  margin-bottom: 18px;
}

.hero-input span {
  color: var(--muted);
  font-size: 14px;
}

.hero-input button {
  width: 36px;
  height: 36px;
  border-radius: 999px;
  border: 1px solid var(--glass-border);
  background: rgba(28, 26, 24, 0.86);
  color: #fefcf9;
  cursor: pointer;
}

.hero-input-action {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border-radius: 999px;
  border: 1px solid var(--glass-border);
  background: rgba(28, 26, 24, 0.86);
  color: #fefcf9;
  font-size: 16px;
}

.hero-visual {
  border-radius: var(--radius-lg);
  padding: 18px;
  display: grid;
  gap: 16px;
}

.hero-visual img {
  width: 100%;
  border-radius: 22px;
}

.hero-visual-details {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.hero-subtitle {
  font-size: 16px;
  line-height: 1.7;
  color: var(--muted);
  margin-bottom: 28px;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 28px;
}

.hero-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.hero-panel {
  border-radius: var(--radius-lg);
  padding: 28px;
  display: grid;
  gap: 18px;
}

.hero-panel .panel-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 13px;
  color: var(--muted-strong);
}

.panel-tag {
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--muted);
}

.hero-panel .panel-row strong {
  color: var(--text);
  font-weight: 600;
}

.hero-panel .panel-tag {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color: var(--muted);
}

.section-title {
  font-size: clamp(28px, 3.6vw, 40px);
  margin: 0 0 16px;
}

.section-subtitle {
  font-size: 15px;
  line-height: 1.6;
  color: var(--muted);
  max-width: 620px;
}

.cards-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  margin-top: 36px;
}

.split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28px;
  margin-top: 32px;
}

.pricing-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20px;
  margin-top: 32px;
}

.waitlist-card {
  border-radius: var(--radius-lg);
  padding: 32px;
  max-width: 520px;
  margin: 0 auto;
  display: grid;
  gap: 18px;
  text-align: center;
}

.input-glass {
  width: 100%;
  padding: 14px 16px;
  border-radius: 999px;
  border: 1px solid var(--glass-border);
  background: rgba(255, 255, 255, 0.7);
  font-size: 14px;
  color: var(--text);
  backdrop-filter: blur(16px);
  box-shadow: var(--shadow-sm);
}

.input-glass:focus {
  outline: none;
  border-color: var(--gold);
  box-shadow: 0 0 0 3px rgba(184, 149, 94, 0.15);
}

.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(17, 15, 12, 0.3);
  backdrop-filter: blur(10px);
  display: grid;
  place-items: center;
  z-index: 50;
}

.modal {
  width: min(480px, calc(100% - 32px));
  border-radius: var(--radius-md);
  padding: 28px;
}

.footer {
  padding: 60px 0 40px;
  color: var(--muted);
  font-size: 13px;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.2fr repeat(3, 1fr);
  gap: 32px;
}

.footer a {
  color: inherit;
}

@media (max-width: 960px) {
  .hero-grid {
    grid-template-columns: 1fr;
  }

  .nav-links {
    display: none;
  }

  .menu-toggle {
    display: inline-flex;
  }

  .cards-grid,
  .split,
  .pricing-grid,
  .footer-grid {
    grid-template-columns: 1fr;
  }

  .section {
    padding: 72px 0;
  }

  .card {
    transform: none !important;
  }
}

@media (max-width: 640px) {
  .hero {
    padding-top: 120px;
  }

  .hero-panel {
    padding: 22px;
  }

  .waitlist-card {
    padding: 24px;
  }
}

.hero-input { transition: transform 0.2s ease, background 0.3s ease, border-color 0.3s ease; }
.hero-input:hover { transform: translateY(-2px); background: rgba(255, 255, 255, 0.15) !important; border-color: rgba(255, 255, 255, 0.3) !important; }
.hero-input-action { transition: transform 0.3s ease; }
.hero-input:hover .hero-input-action { transform: translateX(4px); }
.explore-link { position: relative; text-decoration: none !important; opacity: 0.8; transition: opacity 0.3s ease; }
.explore-link:hover { opacity: 1; }
.explore-link::after { content: ''; position: absolute; width: 100%; height: 1px; bottom: -4px; left: 0; background-color: currentColor; transform: scaleX(0); transform-origin: bottom right; transition: transform 0.3s ease; }
.explore-link:hover::after { transform: scaleX(1); transform-origin: bottom left; }

